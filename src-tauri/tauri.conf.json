{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RunBridge",
  "version": "0.1.2",
  "identifier": "com.jim.runbridge",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "RunBridge",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "resources": {
      "../running_page": "running_page"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNBQjQ0OTIyQUUzQzRFNUQKUldSZFRqeXVJa20wT2hMMmJ0U1ZGTm0rYi9tdW9EOERNRXBaMjJWSEphM09CU3pSZnRTRGdDZ2YK",
      "endpoints": [
        "https://github.com/wenkangzhou/run_bridge/releases/latest/download/latest.json"
      ]
    }
  }
}
